@page
@model Pelicula.web.Pages.ImportModel
@{
    ViewData["Title"] = "Importar Películas";
}

<div class="container mt-4">
    <h2>Importar Rango de Películas desde OMDB</h2>
    <hr />

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted">
                        Agregará automáticamente un rango secuencial de películas desde OMDB a nuestra base de datos local.
                        Ignorará las películas que ya existan o aquellas donde el JSON provisto no sea una película válida.
                    </p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="ImdbIDInicial" class="control-label">IMDb ID Inicial (solo el número)</label>
                            <input asp-for="ImdbIDInicial" class="form-control" type="number" />
                            <small class="form-text text-muted">Ejemplo: 111161 (Corresponde a "tt0111161")</small>
                            <span asp-validation-for="ImdbIDInicial" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="NumeroPeliculas" class="control-label">Número de Películas a Importar</label>
                            <input asp-for="NumeroPeliculas" class="form-control" type="number" min="1" max="100"/>
                            <span asp-validation-for="NumeroPeliculas" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="OmdbApiKey" class="control-label">OMDB API Key</label>
                            <!-- Puesto un valor por defecto o placeholdr en el valor para tu uso  -->
                            <input asp-for="OmdbApiKey" class="form-control" value="892e624f" placeholder="Inserte su API Key aquí..." />
                            <span asp-validation-for="OmdbApiKey" class="text-danger"></span>
                        </div>

                        <!-- Panel Loading (Visible mientras carga) -->
                        <div id="loader" class="text-center d-none my-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="text-info mt-2"><strong>Importando, por favor no cierre ni actualice...</strong></p>
                        </div>

                        <div class="d-flex justify-content-between mb-4">
                            <a asp-page="./Index" class="btn btn-outline-secondary">Volver al listado</a>
                            <button id="btnImportar" type="submit" class="btn btn-primary" onclick="showLoader()">Iniciar Importación</button>
                        </div>
                    </form>

                    <!-- Presentación del registro tras Post -->
                    @if (TempData["MensajesImportacion"] != null)
                    {
                        var mensajesStr = TempData["MensajesImportacion"] as string;
                        var mensajes = mensajesStr!.Split("||", StringSplitOptions.RemoveEmptyEntries);
                        
                        <div class="mt-4">
                            <h4>Log de Ejecución:</h4>
                            <div class="list-group border rounded" style="max-height: 400px; overflow-y: auto;">
                                @foreach (var mensaje in mensajes)
                                {
                                    if (mensaje.StartsWith("✅"))
                                    {
                                        <div class="list-group-item list-group-item-success">@mensaje</div>
                                    }
                                    else if (mensaje.StartsWith("⚠️") || mensaje.StartsWith("❌"))
                                    {
                                        <div class="list-group-item list-group-item-warning">@mensaje</div>
                                    }
                                    else if (mensaje.StartsWith("💥"))
                                    {
                                        <div class="list-group-item list-group-item-danger">@mensaje</div>
                                    }
                                    else
                                    {
                                        <div class="list-group-item">@mensaje</div>
                                    }
                                }
                            </div>
                            <div class="text-center mt-3">
                                <a asp-page="./Index" class="btn btn-success">Hecho. Ir a las Películas</a>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Función miniatura para mostrar el estado cargando y deshabilitar el botón y no crear doble post
        function showLoader() {
            // Evaluamos muy básico si hay api key en base.
            let apiKey = document.getElementById("OmdbApiKey").value;
            if(apiKey === null || apiKey.trim() === ""){
                 return; 
            }
            document.getElementById('loader').classList.remove('d-none');
            document.getElementById('btnImportar').setAttribute('readonly', 'readonly');
            // Nota: No se deshabilita para que pase el submit
        }
    </script>
}